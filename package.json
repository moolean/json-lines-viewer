{
  "name": "json-lines-viewer",
  "displayName": "JSON Lines Viewer (moolean fork)",
  "description": "View each line of JSON Lines file in json format",
  "version": "0.0.6",
  "publisher": "lehoanganh298",
  "repository": {
    "type": "git",
    "url": "https://github.com/moolean/json-lines-viewer.git"
  },
  "engines": {
    "vscode": "^1.64.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "json lines",
    "jsonl",
    "json line",
    "jsonl viewer",
    "jsonl preview"
  ],
  "activationEvents": [
    "onCommand:json-lines-viewer.preview",
    "onCommand:json-lines-viewer.next-line",
    "onCommand:json-lines-viewer.previous-line",
    "onCommand:json-lines-viewer.go-to-line",
    "onCommand:json-lines-viewer.refresh"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-lines-viewer.preview",
        "title": "Open JSON Lines Preview",
        "icon": "$(json)"
      },
      {
        "command": "json-lines-viewer.next-line",
        "title": "JSONL Next Line",
        "icon": "$(arrow-down)",
        "enablement": "resourceScheme == jsonl"
      },
      {
        "command": "json-lines-viewer.previous-line",
        "title": "JSONL Previous Line",
        "icon": "$(arrow-up)",
        "enablement": "resourceScheme == jsonl"
      },
      {
        "command": "json-lines-viewer.go-to-line",
        "title": "JSONL Go to Line",
        "icon": "$(selection)",
        "enablement": "resourceScheme == jsonl"
      },
      {
        "command": "json-lines-viewer.refresh",
        "title": "JSONL Refresh Preview",
        "icon": "$(refresh)",
        "enablement": "resourceScheme == jsonl"
      }
    ],
    "languages": [
      {
        "id": "jsonl",
        "extensions": [
          ".jsonl",
          ".jl",
          ".ndjson"
        ],
        "aliases": [
          "JSON Lines",
          "jsonl"
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceLangId == jsonl || resourceExtname =~ /\\.(jsonl|jl|ndjson)$/i",
          "command": "json-lines-viewer.preview",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "editorLangId == jsonl || resourceExtname =~ /\\.(jsonl|jl|ndjson)$/i || resourceScheme == jsonl",
          "command": "json-lines-viewer.preview",
          "group": "navigation"
        },
        {
          "when": "resourceScheme == jsonl",
          "command": "json-lines-viewer.previous-line",
          "group": "navigation@3"
        },
        {
          "when": "resourceScheme == jsonl",
          "command": "json-lines-viewer.next-line",
          "group": "navigation@1"
        },
        {
          "when": "resourceScheme == jsonl",
          "command": "json-lines-viewer.go-to-line",
          "group": "navigation@2"
        },
        {
          "when": "resourceScheme == jsonl",
          "command": "json-lines-viewer.refresh",
          "group": "navigation@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && mocha --ui tdd out/test/unit/*.test.js"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "14.x",
    "@types/vscode": "^1.64.0",
    "@typescript-eslint/eslint-plugin": "^5.9.1",
    "@typescript-eslint/parser": "^5.9.1",
    "@vscode/test-electron": "^2.0.3",
    "eslint": "^8.6.0",
    "glob": "^7.2.0",
    "mocha": "^9.1.3",
    "typescript": "^4.5.4"
  }
}
